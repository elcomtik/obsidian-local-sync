{
  "name": "obsidian-local-sync",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:plugin",
    "build:plugin": "node esbuild.plugin.config.mjs",
    "build:daemon": "node esbuild.daemon.config.mjs",
    "dev": "node esbuild.plugin.config.mjs --watch",
    "dev:daemon": "node esbuild.daemon.config.mjs --watch",
    "test": "node scripts/run-tests.mjs",
    "smoke:daemon": "npm run build:daemon && node scripts/smoke-daemon.mjs"
  },
  "dependencies": {
    "@evolu/common": "7.4.1",
    "chokidar": "^5.0.0",
    "diff-match-patch": "^1.0.5",
    "sql.js": "^1.14.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^25.9.5",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
