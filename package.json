{
  "name": "obsidian-local-sync",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:plugin",
    "build:plugin": "node esbuild.plugin.config.mjs",
    "build:daemon": "node esbuild.daemon.config.mjs",
    "dev": "node esbuild.plugin.config.mjs --watch",
    "dev:daemon": "node esbuild.daemon.config.mjs --watch",
    "smoke:daemon": "npm run build:daemon && node scripts/smoke-daemon.mjs"
  },
  "dependencies": {
    "@evolu/common": "7.4.1",
    "chokidar": "^5.0.0",
    "diff-match-patch": "^1.0.5",
    "sql.js": "^1.14.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^25.3.0",
    "@types/sql.js": "^1.4.9",
    "esbuild": "^0.25.0",
    "obsidian": "^1.12.2",
    "typescript": "^5.6.0"
  }
}
